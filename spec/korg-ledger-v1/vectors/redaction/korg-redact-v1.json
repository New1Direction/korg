{
  "policy": "korg-redact@v1",
  "note": "Hand-authored expected outputs (not generated by any implementation). findings are in canonical order: JSON pointer by code point, then normative rule order. output null = input unchanged.",
  "cases": [
    {
      "name": "http_headers",
      "input": {
        "headers": {
          "Authorization": "Bearer abcdefghijklmnopqrstuvwx",
          "Accept": "application/json"
        }
      },
      "output": {
        "headers": {
          "Authorization": "[REDACTED:sensitive_key]",
          "Accept": "application/json"
        }
      },
      "findings": [
        {
          "path": "/headers/Authorization",
          "rule": "sensitive_key"
        }
      ]
    },
    {
      "name": "key_normalization",
      "input": {
        "accessToken": "t0k",
        "X-Api-Key": "k",
        "clientSecret": "s",
        "OPENAI_API_KEY": "v",
        "Set-Cookie": "id=1",
        "OAuth2Token": "o"
      },
      "output": {
        "accessToken": "[REDACTED:sensitive_key]",
        "X-Api-Key": "[REDACTED:sensitive_key]",
        "clientSecret": "[REDACTED:sensitive_key]",
        "OPENAI_API_KEY": "[REDACTED:sensitive_key]",
        "Set-Cookie": "[REDACTED:sensitive_key]",
        "OAuth2Token": "[REDACTED:sensitive_key]"
      },
      "findings": [
        {
          "path": "/OAuth2Token",
          "rule": "sensitive_key"
        },
        {
          "path": "/OPENAI_API_KEY",
          "rule": "sensitive_key"
        },
        {
          "path": "/Set-Cookie",
          "rule": "sensitive_key"
        },
        {
          "path": "/X-Api-Key",
          "rule": "sensitive_key"
        },
        {
          "path": "/accessToken",
          "rule": "sensitive_key"
        },
        {
          "path": "/clientSecret",
          "rule": "sensitive_key"
        }
      ]
    },
    {
      "name": "non_secret_lookalikes_kept",
      "input": {
        "prompt_tokens": 10,
        "max_tokens": 5,
        "token_count": 3,
        "tokens": [
          "a"
        ],
        "password_hash_algo": "argon2",
        "secret": false,
        "password": null,
        "api_key": ""
      },
      "output": null,
      "findings": []
    },
    {
      "name": "containers_and_numbers_under_sensitive_keys",
      "input": {
        "credentials": {
          "user": "bob",
          "password": "x"
        },
        "token": 12345,
        "auth": {
          "refresh_token": [
            "a",
            "b"
          ]
        }
      },
      "output": {
        "credentials": "[REDACTED:sensitive_key]",
        "token": "[REDACTED:sensitive_key]",
        "auth": {
          "refresh_token": "[REDACTED:sensitive_key]"
        }
      },
      "findings": [
        {
          "path": "/auth/refresh_token",
          "rule": "sensitive_key"
        },
        {
          "path": "/credentials",
          "rule": "sensitive_key"
        },
        {
          "path": "/token",
          "rule": "sensitive_key"
        }
      ]
    },
    {
      "name": "existing_markers_are_stable",
      "input": {
        "password": "[REDACTED:sensitive_key]",
        "note": "https://[REDACTED:url_credentials]@h/",
        "cmd": "X_TOKEN=[REDACTED:env_assignment]"
      },
      "output": null,
      "findings": []
    },
    {
      "name": "env_assignment",
      "input": "export OPENAI_API_KEY=sk-abcdefghijklmnopqrstuvwxyz0123 && GITHUB_TOKEN='abc def' ./run",
      "output": "export OPENAI_API_KEY=[REDACTED:env_assignment] && GITHUB_TOKEN=[REDACTED:env_assignment] ./run",
      "findings": [
        {
          "path": "",
          "rule": "provider_api_key"
        },
        {
          "path": "",
          "rule": "env_assignment"
        }
      ]
    },
    {
      "name": "env_assignment_yaml_and_dotenv",
      "input": "DB_PASSWORD: hunter2\nAWS_SECRET_ACCESS_KEY=\"wJalr/K7MDENG\"\nDEBUG=1",
      "output": "DB_PASSWORD: [REDACTED:env_assignment]\nAWS_SECRET_ACCESS_KEY=[REDACTED:env_assignment]\nDEBUG=1",
      "findings": [
        {
          "path": "",
          "rule": "env_assignment"
        }
      ]
    },
    {
      "name": "env_lookalikes_kept",
      "input": "MAX_TOKENS=4096 MY_TOKEN_FILE=/tmp/x token=abc Password=abc",
      "output": null,
      "findings": []
    },
    {
      "name": "url_credentials",
      "input": "git clone https://alice:s3cr3t@github.com/o/r.git; ssh git@github.com:o/r; https://bob@h/",
      "output": "git clone https://[REDACTED:url_credentials]@github.com/o/r.git; ssh git@github.com:o/r; https://bob@h/",
      "findings": [
        {
          "path": "",
          "rule": "url_credentials"
        }
      ]
    },
    {
      "name": "bearer_token",
      "input": "curl -H 'Authorization: Bearer abc.def-ghi_jkl~mno+pqr/st==' https://x",
      "output": "curl -H 'Authorization: Bearer [REDACTED:bearer_token]' https://x",
      "findings": [
        {
          "path": "",
          "rule": "bearer_token"
        }
      ]
    },
    {
      "name": "bearer_prose_kept",
      "input": "the bearer of bad news; BEARER short",
      "output": null,
      "findings": []
    },
    {
      "name": "provider_api_keys",
      "input": "a sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAA b sk-proj-0123456789abcdefghijKLMN c task-abcdefghijklmnopqrstuvwxyz",
      "output": "a [REDACTED:provider_api_key] b [REDACTED:provider_api_key] c task-abcdefghijklmnopqrstuvwxyz",
      "findings": [
        {
          "path": "",
          "rule": "provider_api_key"
        }
      ]
    },
    {
      "name": "adjacent_tokens",
      "input": "sk-aaaaaaaaaaaaaaaaaaaaaaaa sk-bbbbbbbbbbbbbbbbbbbbbbbb",
      "output": "[REDACTED:provider_api_key] [REDACTED:provider_api_key]",
      "findings": [
        {
          "path": "",
          "rule": "provider_api_key"
        }
      ]
    },
    {
      "name": "ascii_boundary_before_non_ascii",
      "input": "ésk-abcdefghijklmnopqrstuvwxyz 中AKIAIOSFODNN7EXAMPLE",
      "output": "é[REDACTED:provider_api_key] 中[REDACTED:aws_access_key_id]",
      "findings": [
        {
          "path": "",
          "rule": "provider_api_key"
        },
        {
          "path": "",
          "rule": "aws_access_key_id"
        }
      ]
    },
    {
      "name": "vendor_tokens",
      "input": [
        "ghp_A1b2C3d4E5A1b2C3d4E5A1b2C3d4E5F6g7H8",
        "github_pat_11ABCDEFG011ABCDEFG0xy",
        "xoxb-1234567890-abcdef",
        "AKIAIOSFODNN7EXAMPLE",
        "AIzaSyD-abcdefghijklmnopqrstuvwxyz01234",
        "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U"
      ],
      "output": [
        "[REDACTED:github_token]",
        "[REDACTED:github_token]",
        "[REDACTED:slack_token]",
        "[REDACTED:aws_access_key_id]",
        "[REDACTED:google_api_key]",
        "[REDACTED:jwt]"
      ],
      "findings": [
        {
          "path": "/0",
          "rule": "github_token"
        },
        {
          "path": "/1",
          "rule": "github_token"
        },
        {
          "path": "/2",
          "rule": "slack_token"
        },
        {
          "path": "/3",
          "rule": "aws_access_key_id"
        },
        {
          "path": "/4",
          "rule": "google_api_key"
        },
        {
          "path": "/5",
          "rule": "jwt"
        }
      ]
    },
    {
      "name": "private_key_block",
      "input": {
        "file": "before\n-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA\nabc\n-----END RSA PRIVATE KEY-----\nafter",
        "truncated": "x -----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXk"
      },
      "output": {
        "file": "before\n[REDACTED:private_key_block]\nafter",
        "truncated": "x [REDACTED:private_key_block]"
      },
      "findings": [
        {
          "path": "/file",
          "rule": "private_key_block"
        },
        {
          "path": "/truncated",
          "rule": "private_key_block"
        }
      ]
    },
    {
      "name": "json_secret_field_in_text",
      "input": "{\"password\": \"p\\\"w\", \"user\": \"u\", \"token\":\"t\", \"tokens\": \"n\"}",
      "output": "{\"password\": \"[REDACTED:json_secret_field]\", \"user\": \"u\", \"token\":\"[REDACTED:json_secret_field]\", \"tokens\": \"n\"}",
      "findings": [
        {
          "path": "",
          "rule": "json_secret_field"
        }
      ]
    },
    {
      "name": "pointer_escaping_and_arrays",
      "input": {
        "a/b~c": {
          "api_key": "k"
        },
        "list": [
          {
            "password": "x"
          },
          "Bearer abcdefghijklmnopqrstu"
        ]
      },
      "output": {
        "a/b~c": {
          "api_key": "[REDACTED:sensitive_key]"
        },
        "list": [
          {
            "password": "[REDACTED:sensitive_key]"
          },
          "Bearer [REDACTED:bearer_token]"
        ]
      },
      "findings": [
        {
          "path": "/a~1b~0c/api_key",
          "rule": "sensitive_key"
        },
        {
          "path": "/list/0/password",
          "rule": "sensitive_key"
        },
        {
          "path": "/list/1",
          "rule": "bearer_token"
        }
      ]
    },
    {
      "name": "scalars_untouched",
      "input": [
        42,
        null,
        true,
        -7,
        "plain text"
      ],
      "output": null,
      "findings": []
    }
  ]
}
